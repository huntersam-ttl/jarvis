# ============================================================
# Jarvis environment configuration — COPY to .env and fill in
# ============================================================
# .env is git-ignored. Never commit real secrets.
# Copy this file:  cp .env.example .env

# ---- OpenRouter (AI provider) ----
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Any model id available on OpenRouter, e.g. openai/gpt-4o-mini
OPENROUTER_DEFAULT_MODEL=

# ---- Backend ----
# Comma-separated list of allowed frontend origins (CORS).
# In development, the Next.js dev server runs on http://localhost:3000
JARVIS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set to "dev" for development, "prod" for production
JARVIS_ENV=dev
JARVIS_BACKEND_HOST=127.0.0.1
JARVIS_BACKEND_PORT=8000

# ---- Frontend ----
# Used by Next.js rewrites to proxy API calls to the backend.
JARVIS_BACKEND_URL=http://127.0.0.1:8000
